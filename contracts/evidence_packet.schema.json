{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Football evidence packet",
  "type": "object",
  "required": [
    "match",
    "stage",
    "generated_at",
    "integrity",
    "models",
    "market",
    "warnings"
  ],
  "properties": {
    "match": {
      "type": "object",
      "required": [
        "match_id",
        "home",
        "away",
        "competition",
        "kickoff"
      ],
      "properties": {
        "match_id": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "away": {
          "type": "string"
        },
        "competition": {
          "type": "string"
        },
        "kickoff": {
          "type": "string"
        }
      }
    },
    "stage": {
      "enum": [
        "PRE",
        "POST_XI"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "integrity": {
      "type": "object",
      "required": [
        "sources",
        "stale_sources",
        "flags"
      ],
      "properties": {
        "sources": {
          "type": "array"
        },
        "stale_sources": {
          "type": "array"
        },
        "league_coverage": {
          "type": "number"
        },
        "flags": {
          "type": "array"
        }
      }
    },
    "team_context": {
      "type": "object"
    },
    "availability": {
      "type": "object"
    },
    "xi": {
      "type": "object"
    },
    "models": {
      "type": "object",
      "properties": {
        "individual": {
          "type": "object"
        },
        "ensemble": {
          "type": "object"
        },
        "model_agreement": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "market": {
      "type": "object",
      "required": [
        "summary",
        "model_vs_market"
      ],
      "properties": {
        "consensus_1x2": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        },
        "model_vs_market": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "correlation_families": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
