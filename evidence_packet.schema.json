{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Football ChatGPT Decision Evidence Packet",
  "type": "object",
  "required": ["schema_version","engine_version","generated_at","match","stage","integrity","models","market","decision_authority","production_decision"],
  "properties": {
    "schema_version": {"type":"string"},
    "engine_version": {"type":"string"},
    "generated_at": {"type":"string"},
    "match": {"type":"object"},
    "stage": {"enum":["PRE","POST_XI"]},
    "integrity": {
      "type":"object",
      "required":["data_quality","league_coverage","flags"],
      "properties":{
        "data_quality":{"type":"number","minimum":0,"maximum":1},
        "league_coverage":{"type":"number","minimum":0,"maximum":1},
        "flags":{"type":"array","items":{"type":"string"}}
      }
    },
    "source_evidence":{"type":"array","items":{"type":"object"}},
    "models":{
      "type":"object",
      "required":["individual","ensemble","model_agreement"],
      "properties":{
        "individual":{"type":"object"},
        "ensemble":{"type":"object"},
        "model_agreement":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "market":{
      "type":"object",
      "required":["candidates"],
      "properties":{
        "consensus_1x2":{"type":"object"},
        "candidates":{"type":"array","items":{"type":"object"}}
      }
    },
    "xi":{"type":"object"},
    "context":{"type":"object"},
    "decision_authority":{"const":"CHATGPT_ONLY"},
    "production_decision":{"type":"null"},
    "warnings":{"type":"array","items":{"type":"string"}}
  }
}